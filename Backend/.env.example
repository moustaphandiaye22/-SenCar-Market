NODE_ENV=development
PORT=8082
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require&channel_binding=require
JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_ENABLED=false
OTP_EMAIL_FROM=no-reply@sencarmarket.com

# Redis (optional - for caching and rate limiting in production)
REDIS_URL=redis://localhost:6379

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Paiement providers
PAIEMENTS_WAVE_PAY_URL_BASE=https://wave.com/pay
PAIEMENTS_WAVE_SECRET=
PAIEMENTS_OM_PAY_URL_BASE=https://om.sn/pay
PAIEMENTS_OM_SECRET=
PAIEMENTS_COMMISSION_TAUX=0.05

# cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
