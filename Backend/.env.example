NODE_ENV=development
PORT=8082
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require&channel_binding=require
JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_ENABLED=false
OTP_EMAIL_FROM=no-reply@sencarmarket.com
