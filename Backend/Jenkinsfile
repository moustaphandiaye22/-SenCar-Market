pipeline {
    agent any

    environment {
        DOCKER_IMAGE_NAME = 'moustaphafullstacker/sencar-market-backend'
        DOCKER_HUB_REPO = 'moustaphafullstacker/sencar-market-backend'
    }

    triggers {
        pollSCM('* * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub...'
                checkout scm
            }
        }

        stage('Install') {
            steps {
                echo 'Installing backend dependencies...'
                sh 'cd Backend && npm ci'
            }
        }

        stage('Lint') {
            steps {
                echo 'Running ESLint...'
                sh 'cd Backend && npx eslint .'
            }
        }

        stage('Unit Tests') {
            steps {
                echo 'Running unit tests with coverage...'
                sh 'cd Backend && npm run test -- --coverage'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'Starting SonarCloud analysis...'
                withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                    sh 'cd Backend && npx sonar-scanner \
                        -Dsonar.token=$SONAR_TOKEN \
                        -Dsonar.host.url=https://sonarcloud.io'
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Building backend application...'
                sh 'cd Backend && npm run build'
            }
        }

        stage('Docker Build & Push') {
            steps {
                echo 'Building Docker image...'
                sh "docker build -t ${DOCKER_IMAGE_NAME}:${BUILD_NUMBER} -t ${DOCKER_IMAGE_NAME}:latest Backend/"

                echo 'Logging into Docker Hub...'
                withCredentials([usernamePassword(credentialsId: 'DOCKER_HUB_CREDENTIALS', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin'

                    echo 'Pushing Docker image to Docker Hub...'
                    sh "docker push ${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"
                    sh "docker push ${DOCKER_IMAGE_NAME}:latest"

                    echo 'Logging out from Docker Hub...'
                    sh 'docker logout'
                }
            }
        }

        stage('Deploy to Render') {
            steps {
                echo 'Deploying backend to Render...'
                withCredentials([string(credentialsId: 'RENDER_DEPLOY_HOOK_BACKEND', variable: 'RENDER_HOOK_URL')]) {
                    sh 'curl -s -X POST $RENDER_HOOK_URL'
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving test reports...'
            archiveArtifacts artifacts: 'Backend/coverage/**', allowEmptyArchive: true
            junit testResults: 'Backend/coverage/jest-results.xml', allowEmptyResults: true
        }
        failure {
            echo "BACKEND BUILD FAILED - Build #${BUILD_NUMBER}"
        }
        success {
            echo "BACKEND DEPLOYED - Build #${BUILD_NUMBER}"
        }
    }
}
