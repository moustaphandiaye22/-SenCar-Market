generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model abonnement {
  id                     String                   @id @db.Uuid
  nom                    String                   @db.VarChar(100)
  description            String?
  prix_mensuel           Decimal?                 @db.Decimal(12, 2)
  duree_jours            Int?
  nombre_annonces        Int?
  est_vedette            Boolean?
  est_certifie           Boolean?
  type                   TypeAbonnement?
  est_actif              Boolean?                 @default(true)
  avantages              String?
  prix_annuel            Decimal?                 @db.Decimal(12, 2)
  nombre_boosts_gratuits Int?
  acces_prioritaire      Boolean?
  support_prioritaire    Boolean?
  utilisateur_abonnement utilisateur_abonnement[]
}

model annonce_location {
  id                      String                   @id @db.Uuid
  proprietaire_id         String                   @db.Uuid
  vehicule_id             String?                  @db.Uuid
  tarif_journalier        Decimal?                 @db.Decimal(12, 2)
  statut                  String?                  @db.VarChar(50)
  description             String?
  conditions              String?
  caution                 Decimal?                 @db.Decimal(12, 2)
  kilometrage_inclus      Int?
  tarif_km_supplementaire Decimal?                 @db.Decimal(12, 2)
  actif                   Boolean?
  created_at              DateTime?                @default(now())
  updated_at              DateTime?
  utilisateur             utilisateur              @relation(fields: [proprietaire_id], references: [id])
  vehicule                vehicule?                @relation(fields: [vehicule_id], references: [id])
  boost_annonce           boost_annonce[]
  conversation            conversation[]
  disponibilite_location  disponibilite_location[]
  reservation_location    reservation_location[]

  @@index([statut, actif], map: "idx_annonce_location_statut_actif")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model avis {
  id                                                 String       @id @db.Uuid
  auteur_id                                          String       @db.Uuid
  cible_utilisateur_id                               String?      @db.Uuid
  vehicule_id                                        String?      @db.Uuid
  garage_id                                          String?      @db.Uuid
  type_avis                                          TypeAvis?
  transaction_id                                     String       @db.Uuid
  note                                               Int
  commentaire                                        String?
  statut                                             StatutAvis?
  created_at                                         DateTime?    @default(now())
  utilisateur_avis_auteur_idToutilisateur            utilisateur  @relation("avis_auteur_idToutilisateur", fields: [auteur_id], references: [id])
  utilisateur_avis_cible_utilisateur_idToutilisateur utilisateur? @relation("avis_cible_utilisateur_idToutilisateur", fields: [cible_utilisateur_id], references: [id])
  garage                                             garage?      @relation(fields: [garage_id], references: [id])
  vehicule                                           vehicule?    @relation(fields: [vehicule_id], references: [id])

  @@index([cible_utilisateur_id, statut], map: "idx_avis_cible_utilisateur_statut")
  @@index([garage_id, statut], map: "idx_avis_garage_statut")
  @@index([transaction_id], map: "idx_avis_transaction")
  @@index([vehicule_id, statut], map: "idx_avis_vehicule_statut")
}

model boite_vitesse {
  id       String     @id @db.Uuid
  nom      String?    @db.VarChar(50)
  vehicule vehicule[]
}

model boost_annonce {
  id                  String           @id @db.Uuid
  annonce_location_id String           @db.Uuid
  date_debut          DateTime?
  date_fin            DateTime?
  niveau_boost        String?          @db.VarChar(50)
  statut              StatutBoost?     @default(EN_ATTENTE)
  payment_id          String?          @db.Uuid
  annonce_location    annonce_location @relation(fields: [annonce_location_id], references: [id])

  @@index([annonce_location_id], map: "idx_boost_annonce_location")
  @@index([payment_id], map: "idx_boost_annonce_payment")
}

model carburant {
  id       String     @id @db.Uuid
  nom      String?    @db.VarChar(50)
  vehicule vehicule[]
}

model conversation {
  id                                               String                     @id @db.Uuid
  titre                                            String?                    @db.VarChar(255)
  type_conversation                                TypeConversation?
  annonce_id                                       String?                    @db.Uuid
  message_epingle_id                               String?                    @db.Uuid
  avatar_url                                       String?
  cree_par                                         String?                    @db.Uuid
  est_groupe                                       Boolean?
  created_at                                       DateTime?                  @default(now())
  updated_at                                       DateTime?
  annonce_location                                 annonce_location?          @relation(fields: [annonce_id], references: [id])
  utilisateur                                      utilisateur?               @relation(fields: [cree_par], references: [id])
  message_conversation_message_epingle_idTomessage message?                   @relation("conversation_message_epingle_idTomessage", fields: [message_epingle_id], references: [id])
  conversation_participant                         conversation_participant[]
  message_message_conversation_idToconversation    message[]                  @relation("message_conversation_idToconversation")
}

model conversation_participant {
  id                    String       @id @db.Uuid
  conversation_id       String       @db.Uuid
  utilisateur_id        String       @db.Uuid
  date_join             DateTime?
  est_admin             Boolean?
  est_mute              Boolean?
  derniere_lecture_date DateTime?
  nombre_non_lus        Int?
  a_rejoint_le          DateTime?
  conversation          conversation @relation(fields: [conversation_id], references: [id])
  utilisateur           utilisateur  @relation(fields: [utilisateur_id], references: [id])

  @@unique([conversation_id, utilisateur_id])
}

model demande_certification {
  id                                                            String                     @id @db.Uuid
  utilisateur_id                                                String                     @db.Uuid
  vehicule_id                                                   String                     @db.Uuid
  statut                                                        StatutDemandeCertification
  montant_paiement                                              Decimal?                   @db.Decimal(12, 2)
  paiement_id                                                   String?                    @db.Uuid
  inspecteur_id                                                 String?                    @db.Uuid
  date_soumission                                               DateTime?
  date_traitement                                               DateTime?
  date_inspection                                               DateTime?
  motif_rejet                                                   String?
  badge_certifie_url                                            String?                    @db.VarChar(500)
  created_at                                                    DateTime?                  @default(now())
  updated_at                                                    DateTime?
  utilisateur_demande_certification_inspecteur_idToutilisateur  utilisateur?               @relation("demande_certification_inspecteur_idToutilisateur", fields: [inspecteur_id], references: [id])
  paiement                                                      paiement?                  @relation(fields: [paiement_id], references: [id])
  utilisateur_demande_certification_utilisateur_idToutilisateur utilisateur                @relation("demande_certification_utilisateur_idToutilisateur", fields: [utilisateur_id], references: [id])
  vehicule                                                      vehicule                   @relation(fields: [vehicule_id], references: [id])
  inspection                                                    inspection[]

  @@index([statut], map: "idx_demande_certification_statut")
  @@index([utilisateur_id], map: "idx_demande_certification_utilisateur")
  @@index([vehicule_id], map: "idx_demande_certification_vehicule")
}

model demande_trade_in {
  id                                                       String               @id @db.Uuid
  utilisateur_id                                           String               @db.Uuid
  vehicule_actuel_id                                       String               @db.Uuid
  vehicule_souhaite_id                                     String?              @db.Uuid
  statut                                                   StatutTradeIn
  prix_estime                                              Decimal?             @db.Decimal(12, 2)
  prix_propose                                             Decimal?             @db.Decimal(12, 2)
  kilometrage_actuel                                       Int?
  etat_vehicule                                            EtatVehiculeTradeIn?
  date_soumission                                          DateTime?
  date_traitement                                          DateTime?
  date_evaluation                                          DateTime?
  motif_rejet                                              String?
  commentaire_admin                                        String?
  est_notifie                                              Boolean?             @default(false)
  created_at                                               DateTime?            @default(now())
  updated_at                                               DateTime?
  utilisateur                                              utilisateur          @relation(fields: [utilisateur_id], references: [id])
  vehicule_demande_trade_in_vehicule_actuel_idTovehicule   vehicule             @relation("demande_trade_in_vehicule_actuel_idTovehicule", fields: [vehicule_actuel_id], references: [id])
  vehicule_demande_trade_in_vehicule_souhaite_idTovehicule vehicule?            @relation("demande_trade_in_vehicule_souhaite_idTovehicule", fields: [vehicule_souhaite_id], references: [id])

  @@index([est_notifie], map: "idx_demande_trade_in_notifie")
  @@index([statut], map: "idx_demande_trade_in_statut")
  @@index([utilisateur_id], map: "idx_demande_trade_in_utilisateur")
}

model disponibilite_location {
  id                  String           @id @db.Uuid
  annonce_location_id String           @db.Uuid
  date                DateTime?
  est_disponible      Boolean?
  annonce_location    annonce_location @relation(fields: [annonce_location_id], references: [id])
}

model garage {
  id                         String                       @id @db.Uuid
  nom                        String                       @db.VarChar(255)
  adresse                    String                       @db.VarChar(500)
  telephone                  String                       @db.VarChar(50)
  email                      String?                      @db.VarChar(255)
  description                String?
  horaires_ouverture         String?
  latitude                   Float?
  longitude                  Float?
  ville                      String?                      @db.VarChar(255)
  pays                       String?                      @db.VarChar(255)
  logo_url                   String?                      @db.VarChar(500)
  statut_validation          StatutValidationGarage?
  commentaire_admin          String?
  date_validation            DateTime?
  utilisateur_id             String?                      @db.Uuid
  created_at                 DateTime?                    @default(now())
  updated_at                 DateTime?
  avis                       avis[]
  utilisateur                utilisateur?                 @relation(fields: [utilisateur_id], references: [id])
  garage_service_association garage_service_association[]

  @@index([statut_validation], map: "idx_garage_statut_validation")
  @@index([utilisateur_id], map: "idx_garage_utilisateur")
  @@index([ville, statut_validation], map: "idx_garage_ville_statut")
}

model garage_service_association {
  id             String         @id @db.Uuid
  garage_id      String         @db.Uuid
  service_id     String         @db.Uuid
  prix           Decimal?       @db.Decimal(12, 2)
  duree_estimee  Int?
  actif          Boolean?       @default(true)
  created_at     DateTime?      @default(now())
  updated_at     DateTime?
  garage         garage         @relation(fields: [garage_id], references: [id])
  service_garage service_garage @relation(fields: [service_id], references: [id])

  @@unique([garage_id, service_id], map: "uk_garage_service")
  @@index([garage_id], map: "idx_garage_service_garage")
  @@index([service_id], map: "idx_garage_service_service")
}

model historique_estimation {
  id                String               @id @db.Uuid
  vehicule_id       String               @db.Uuid
  marque            String?              @db.VarChar(100)
  modele            String?              @db.VarChar(100)
  annee_fabrication Int?
  kilometrage       Int?
  etat_vehicule     EtatVehiculeTradeIn?
  prix_estime       Decimal?             @db.Decimal(12, 2)
  prix_minimum      Decimal?             @db.Decimal(12, 2)
  prix_maximum      Decimal?             @db.Decimal(12, 2)
  score_condition   Float?
  recommandation    String?
  date_estimation   DateTime?
  vehicule          vehicule             @relation(fields: [vehicule_id], references: [id])

  @@index([vehicule_id, date_estimation], map: "idx_historique_estimation_vehicule_date")
}

model historique_statut_reservation {
  id                   String               @id @db.Uuid
  reservation_id       String               @db.Uuid
  ancien_statut_id     String?              @db.Uuid
  nouveau_statut_id    String?              @db.Uuid
  created_at           DateTime?            @default(now())
  reservation_location reservation_location @relation(fields: [reservation_id], references: [id])
}

model inspection {
  id                       String                  @id @db.Uuid
  demande_certification_id String                  @db.Uuid
  inspecteur_id            String                  @db.Uuid
  date_inspection          DateTime?
  resultat                 ResultatInspection?
  commentaire              String?
  kilometrage              Int?
  etat_moteur              EtatVehiculeInspection?
  etat_generateur          EtatVehiculeInspection?
  etat_freinage            EtatVehiculeInspection?
  etat_suspension          EtatVehiculeInspection?
  etat_transmission        EtatVehiculeInspection?
  etat_pneus               EtatVehiculeInspection?
  etat_carrosserie         EtatVehiculeInspection?
  etat_interieur           EtatVehiculeInspection?
  score_total              Int?
  created_at               DateTime?               @default(now())
  updated_at               DateTime?
  demande_certification    demande_certification   @relation(fields: [demande_certification_id], references: [id])
  utilisateur              utilisateur             @relation(fields: [inspecteur_id], references: [id])
  rapport_inspection       rapport_inspection?

  @@index([demande_certification_id], map: "idx_inspection_demande")
  @@index([inspecteur_id], map: "idx_inspection_inspecteur")
}

model marque {
  id       String     @id @db.Uuid
  nom      String?    @db.VarChar(100)
  modele   modele[]
  vehicule vehicule[]
}

model message {
  id                                                    String         @id @db.Uuid
  conversation_id                                       String         @db.Uuid
  utilisateur_id                                        String         @db.Uuid
  contenu                                               String
  date_envoi                                            DateTime?
  date_lecture                                          DateTime?
  est_lu                                                Boolean?
  est_supprime                                          Boolean?
  est_epingle                                           Boolean?
  type_message                                          TypeMessage?
  created_at                                            DateTime?      @default(now())
  conversation_conversation_message_epingle_idTomessage conversation[] @relation("conversation_message_epingle_idTomessage")
  conversation_message_conversation_idToconversation    conversation   @relation("message_conversation_idToconversation", fields: [conversation_id], references: [id])
  utilisateur                                           utilisateur    @relation(fields: [utilisateur_id], references: [id])

  @@index([conversation_id, date_envoi], map: "idx_message_conversation_date")
}

model modele {
  id        String     @id @db.Uuid
  marque_id String?    @db.Uuid
  nom       String?    @db.VarChar(100)
  marque    marque?    @relation(fields: [marque_id], references: [id])
  vehicule  vehicule[]
}

model notification {
  id             String           @id @db.Uuid
  utilisateur_id String           @db.Uuid
  titre          String           @db.VarChar(255)
  message        String
  type           TypeNotification
  est_lu         Boolean?         @default(false)
  reference_id   String?          @db.Uuid
  reference_type String?          @db.VarChar(50)
  date_lecture   DateTime?
  created_at     DateTime?        @default(now())
  utilisateur    utilisateur      @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id], map: "idx_notification_utilisateur")
  @@index([utilisateur_id, est_lu], map: "idx_notification_utilisateur_lu")
}

model option_assurance {
  id                   String                 @id @db.Uuid
  produit_assurance_id String                 @db.Uuid
  nom                  String                 @db.VarChar(255)
  description          String?
  prix_supplementaire  Decimal?               @db.Decimal(12, 2)
  est_actif            Boolean?               @default(true)
  created_at           DateTime?              @default(now())
  updated_at           DateTime?
  produit_assurance    produit_assurance      @relation(fields: [produit_assurance_id], references: [id])
  souscription_options souscription_options[]

  @@index([est_actif], map: "idx_option_assurance_actif")
  @@index([produit_assurance_id], map: "idx_option_assurance_produit")
}

model otp_code {
  id             String      @id @db.Uuid
  utilisateur_id String      @db.Uuid
  code           String      @db.VarChar(6)
  type           OtpType
  expiration     DateTime
  utilise        Boolean     @default(false)
  tentatives     Int         @default(0)
  created_at     DateTime    @default(now())
  utilisateur    utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id, type], map: "idx_otp_utilisateur")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model paiement {
  id                                                                 String                   @id @db.Uuid
  utilisateur_id                                                     String?                  @db.Uuid
  reservation_id                                                     String?                  @db.Uuid
  montant                                                            Decimal                  @db.Decimal(15, 2)
  montant_escrow                                                     Decimal?                 @db.Decimal(15, 2)
  commission                                                         Decimal?                 @default(0) @db.Decimal(15, 2)
  methode_paiement                                                   TypePaiement?
  statut                                                             StatutPaiement
  is_escrow                                                          Boolean?                 @default(false)
  reference_transaction                                              String?                  @db.VarChar(100)
  reference_externe                                                  String?                  @db.VarChar(100)
  url_paiement                                                       String?                  @db.VarChar(500)
  date_paiement                                                      DateTime?
  date_expiration                                                    DateTime?
  created_at                                                         DateTime?                @default(now())
  updated_at                                                         DateTime?
  demande_certification                                              demande_certification[]
