  paiement             paiement?              @relation(fields: [paiement_id], references: [id])
  produit_assurance    produit_assurance      @relation(fields: [produit_assurance_id], references: [id])
  utilisateur          utilisateur            @relation(fields: [utilisateur_id], references: [id])
  vehicule             vehicule               @relation(fields: [vehicule_id], references: [id])
  souscription_options souscription_options[]

  @@index([statut], map: "idx_souscription_assurance_statut")
  @@index([utilisateur_id], map: "idx_souscription_assurance_utilisateur")
  @@index([vehicule_id], map: "idx_souscription_assurance_vehicule")
}

model souscription_options {
