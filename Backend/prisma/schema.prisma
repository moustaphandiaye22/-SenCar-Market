  souscription_assurance                                             souscription_assurance[]

  @@index([statut], map: "idx_paiement_statut")
  @@index([utilisateur_id], map: "idx_paiement_utilisateur")
}

model paiement_log {
  id          String    @id @db.Uuid
  paiement_id String?   @db.Uuid
  action      String    @db.VarChar(50)
  details     String?
  date_action DateTime? @default(now())
  paiement    paiement? @relation(fields: [paiement_id], references: [id])
}

model photo_vehicule {
  id             String    @id @db.Uuid
  vehicule_id    String    @db.Uuid
  url            String    @db.VarChar(500)
  est_principale Boolean?
  ordre          Int?
  created_at     DateTime? @default(now())
  vehicule       vehicule  @relation(fields: [vehicule_id], references: [id])
}

model portefeuille {
  id                       String                     @id @db.Uuid
  utilisateur_id           String                     @unique @db.Uuid
  solde                    Decimal?                   @default(0) @db.Decimal(15, 2)
  solde_bloque             Decimal?                   @default(0) @db.Decimal(15, 2)
  is_actif                 Boolean?                   @default(true)
  date_derniere_recharge   DateTime?
  created_at               DateTime?                  @default(now())
  updated_at               DateTime?
  utilisateur              utilisateur                @relation(fields: [utilisateur_id], references: [id])
  transaction_portefeuille transaction_portefeuille[]
}

model produit_assurance {
  id                     String                   @id @db.Uuid
  nom                    String                   @db.VarChar(255)
  description            String?
  prix_base              Decimal                  @db.Decimal(12, 2)
  type_assurance         TypeAssurance
  duree_mois             Int?
  est_actif              Boolean?                 @default(true)
  created_at             DateTime?                @default(now())
  updated_at             DateTime?
  option_assurance       option_assurance[]
  souscription_assurance souscription_assurance[]

  @@index([est_actif], map: "idx_produit_assurance_actif")
}

model rapport_inspection {
  id              String     @id @db.Uuid
  inspection_id   String     @unique @db.Uuid
  url_rapport_pdf String?    @db.VarChar(500)
  date_generation DateTime?
  score_globale   Int?
  recommendations String?
  conclusion      String?
  est_approuve    Boolean?
  created_at      DateTime?  @default(now())
  updated_at      DateTime?
  inspection      inspection @relation(fields: [inspection_id], references: [id])
}

