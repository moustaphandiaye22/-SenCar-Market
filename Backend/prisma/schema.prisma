model service_garage {
  id                         String                       @id @db.Uuid
  nom                        String                       @db.VarChar(255)
  description                String?
  prix                       Decimal?                     @db.Decimal(12, 2)
  duree_estimee              Int?
  categorie                  CategorieServiceGarage?
  actif                      Boolean?                     @default(true)
  created_at                 DateTime?                    @default(now())
  updated_at                 DateTime?
  garage_service_association garage_service_association[]

  @@index([actif], map: "idx_service_garage_actif")
  @@index([categorie, actif], map: "idx_service_garage_categorie_actif")
}

model signalement {
  id                                                  String                      @id @db.Uuid
  utilisateur_id                                      String                      @db.Uuid
  type_entite                                         TypeEntiteSignalable
  entite_id                                           String                      @db.Uuid
