  utilisateur_signalement_traite_parToutilisateur     utilisateur?                @relation("signalement_traite_parToutilisateur", fields: [traite_par], references: [id])
  utilisateur_signalement_utilisateur_idToutilisateur utilisateur                 @relation("signalement_utilisateur_idToutilisateur", fields: [utilisateur_id], references: [id])

  @@index([statut_traitement], map: "idx_signalement_statut")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
